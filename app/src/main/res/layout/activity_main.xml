<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Поле для ввода текста -->
    <EditText
        android:id="@+id/edit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="Введите текст" />

    <!-- Кнопка логирования Log: яркий цвет, без сглаживания углов -->
    <Button
        android:id="@+id/button_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#8000FF"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:text="ЛОГИРОВАНИЕ LOG"
        android:textColor="#FFFFFF"
        app:cornerRadius="0dp" />

    <!-- Кнопка логирования Timber: яркий цвет, без сглаживания углов -->
    <Button
        android:id="@+id/button_timber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#8000FF"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:text="ЛОГИРОВАНИЕ TIMBER"
        android:textColor="#FFFFFF"
        app:cornerRadius="0dp" />

</LinearLayout>